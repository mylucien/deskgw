#!/bin/sh /etc/rc.common
# deskgw 网关服务。前端与后端在同一个二进制中，默认仅监听 HTTPS 8443。

START=95
STOP=10
USE_PROCD=1

PROG=/usr/bin/deskgw

start_service() {
	local enabled listen cert key cert_names data_dir idle upload cookie_secure redirect mem_limit
	local perf_enabled perf_listen perf_cert perf_key perf_identity perf_udp_tune perf_udp_buf_mb

	config_load deskgw
	config_get_bool enabled main enabled 1
	[ "$enabled" -eq 1 ] || return 0

	config_get listen main listen '0.0.0.0:8443'
	config_get cert main cert '/etc/deskgw/server.crt'
	config_get key main key '/etc/deskgw/server.key'
	config_get cert_names main cert_names ''
	config_get data_dir main data_dir '/etc/deskgw'
	config_get idle main session_idle_min '30'
	config_get upload main max_upload_mb '2048'
	config_get_bool cookie_secure main cookie_secure 1
	config_get redirect main redirect_listen ''
	config_get mem_limit main gomemlimit ''
	config_get_bool perf_enabled main perf_enabled 0
	config_get perf_listen main perf_listen '0.0.0.0:4433'
	config_get perf_cert main perf_cert '/etc/deskgw/perf.crt'
	config_get perf_key main perf_key '/etc/deskgw/perf.key'
	config_get perf_identity main perf_identity '/etc/deskgw/perf_identity'
	config_get_bool perf_udp_tune main perf_udp_tune 1
	config_get perf_udp_buf_mb main perf_udp_buf_mb '8'

	# 性能模式的 UDP 缓冲：由 helper 写入内核并持久化到 /etc/sysctl.conf。
	# helper 失败只记日志，不让网关服务起不来。
	if [ "$perf_udp_tune" -eq 1 ]; then
		/usr/libexec/deskgw/udp-tune.sh "$perf_udp_buf_mb" || echo "deskgw: UDP 缓冲设置失败" >&2
	else
		/usr/libexec/deskgw/udp-tune.sh 0 >/dev/null 2>&1 || true
	fi

	if [ -z "$mem_limit" ]; then
		# Go 默认把 GC 目标定在「堆的两倍」，而单次 Argon2 就要约 19MB。
		# 小内存路由器上不设上限时，几次并发登录就能把常驻内存顶到 OOM。
		# 按物理内存的 40% 估算，下限 96MiB、上限 256MiB。这是软限制，
		# 不会预先占用，只在堆增长时提前触发回收。
		total_kb=$(awk '/^MemTotal:/ {print $2}' /proc/meminfo 2>/dev/null)
		case "$total_kb" in ''|*[!0-9]*) total_kb=262144 ;; esac
		limit_kb=$((total_kb * 40 / 100))
		if [ "$limit_kb" -lt 98304 ]; then limit_kb=98304; fi
		if [ "$limit_kb" -gt 262144 ]; then limit_kb=262144; fi
		mem_limit="${limit_kb}KiB"
	fi

	mkdir -p "$data_dir" || return 1
	chmod 700 "$data_dir"

	procd_open_instance 'main'
	procd_set_param command "$PROG"
	procd_set_param env \
		DESKGW_LISTEN="$listen" \
		DESKGW_REDIRECT_LISTEN="$redirect" \
		DESKGW_CERT="$cert" \
		DESKGW_KEY="$key" \
		DESKGW_CERT_NAMES="$cert_names" \
		DESKGW_DATA_DIR="$data_dir" \
		DESKGW_SESSION_IDLE_MIN="$idle" \
		DESKGW_MAX_UPLOAD_MB="$upload" \
		DESKGW_COOKIE_SECURE="$cookie_secure" \
		DESKGW_PERF_ENABLED="$perf_enabled" \
		DESKGW_PERF_LISTEN="$perf_listen" \
		DESKGW_PERF_CERT="$perf_cert" \
		DESKGW_PERF_KEY="$perf_key" \
		DESKGW_PERF_IDENTITY="$perf_identity" \
		GOMEMLIMIT="$mem_limit"
	procd_set_param file /etc/config/deskgw
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

service_triggers() {
	procd_add_reload_trigger 'deskgw'
}

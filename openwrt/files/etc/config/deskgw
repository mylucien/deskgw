config deskgw 'main'
	option enabled '1'
	option listen '0.0.0.0:8443'
	option cert '/etc/deskgw/server.crt'
	option key '/etc/deskgw/server.key'
	option cert_names ''
	option data_dir '/etc/deskgw'
	option session_idle_min '30'
	option max_upload_mb '2048'
	option cookie_secure '1'
	# 明文 HTTP 跳转监听地址，例如 '0.0.0.0:80'；留空关闭。
	option redirect_listen ''
	# Go 运行时内存软上限，例如 '160MiB'；留空则按物理内存的 40% 自动计算。
	option gomemlimit ''
	# 性能模式：接收 Airhand 被控端的 QUIC 连接。默认关闭；打开后建议只监听
	# 局域网接口（例如 192.168.1.1:4433），别把 UDP 端口暴露到公网。
	option perf_enabled '0'
	option perf_listen '0.0.0.0:4433'
	option perf_cert '/etc/deskgw/perf.crt'
	option perf_key '/etc/deskgw/perf.key'
	# 路由器作为控制端的 X25519 私钥，首次启动自动生成（权限 600）。
	# 它的公钥要写进每台被控端 config.toml 的 [[paired]].key；丢了要重新预置所有被控端。
	option perf_identity '/etc/deskgw/perf_identity'
	# 性能模式的 UDP 接收缓冲优化：服务启动时写入 net.core.rmem_max / wmem_max，
	# 并持久化到 /etc/sysctl.conf。默认开启；高码率视频需要关闭时可将此值设为 0。
	option perf_udp_tune '1'
	# UDP 接收缓冲上限（MiB），默认 8。仅在 perf_udp_tune 开启时生效。
	option perf_udp_buf_mb '8'
